{{!
    @template core/user_action_menu_items

    Everon override of core/user_action_menu_items (from Boost Union).

    When everontiles is set (theme_everon/enableusermenutiles): 3-column tile grid
    matching Launch Pad. Dividers are omitted. Same destinations as Boost.

    When everontiles is unset/false: Union vertical list markup.
}}
{{#everontiles}}
<div class="everon-usermenu__grid" role="none">
{{#items}}
    {{#link}}
        <a href="{{{url}}}" class="everon-usermenu__tile dropdown-item {{#menuclasses}} {{.}} {{/menuclasses}}" role="menuitem" tabindex="-1" {{#tooltip}}title="{{.}}" data-bs-toggle="tooltip"{{/tooltip}} {{#attributes}}{{#name}}{{name}}="{{value}}"{{/name}} {{/attributes}}>
            <span class="everon-usermenu__tile-icon" aria-hidden="true">
                {{#pixicon}}
                    {{#pix}}{{pixicon}}{{/pix}}
                {{/pixicon}}
                {{^pixicon}}
                    {{#imgsrc}}<img src="{{imgsrc}}" alt=""/>{{/imgsrc}}
                    {{^imgsrc}}<i class="fa {{faicon}}"></i>{{/imgsrc}}
                {{/pixicon}}
            </span>
            <span class="everon-usermenu__tile-label">{{#text}}{{{text}}}{{/text}}{{^text}}{{title}}{{/text}}</span>
        </a>
    {{/link}}
    {{#submenulink}}
        <a href="#" class="carousel-navigation-link everon-usermenu__tile dropdown-item {{#menuclasses}} {{.}} {{/menuclasses}}" role="menuitem" tabindex="-1" data-carousel-target-id="carousel-item-{{submenuid}}" {{#tooltip}}title="{{.}}" data-bs-toggle="tooltip"{{/tooltip}}
        {{#attributes}}{{#name}}{{name}}="{{value}}"{{/name}}{{/attributes}}>
            <span class="everon-usermenu__tile-icon" aria-hidden="true">
                {{#pixicon}}
                    {{#pix}}{{pixicon}}{{/pix}}
                {{/pixicon}}
                {{^pixicon}}
                    {{#imgsrc}}<img src="{{imgsrc}}" alt=""/>{{/imgsrc}}
                    {{^imgsrc}}<i class="fa {{faicon}}"></i>{{/imgsrc}}
                {{/pixicon}}
            </span>
            <span class="everon-usermenu__tile-label">{{#text}}{{{text}}}{{/text}}{{^text}}{{title}}{{/text}}</span>
        </a>
    {{/submenulink}}
{{/items}}
</div>
{{/everontiles}}
{{^everontiles}}
{{#items}}
    {{#link}}
        <a href="{{{url}}}" class="dropdown-item {{#menuclasses}} {{.}} {{/menuclasses}}" role="menuitem" tabindex="-1" {{#tooltip}}title="{{.}}" data-bs-toggle="tooltip"{{/tooltip}} {{#attributes}}{{#name}}{{name}}="{{value}}"{{/name}} {{/attributes}}>
            {{#pixicon}}
                {{#pix}}{{pixicon}}{{/pix}}
            {{/pixicon}}
            {{^pixicon}}
                {{#imgsrc}}<img aria-hidden="true" src="{{imgsrc}}" alt="{{title}}"/>{{/imgsrc}}
            {{/pixicon}}
            {{#text}}{{{text}}}{{/text}}{{^text}}{{title}}{{/text}}
        </a>
    {{/link}}
    {{#submenulink}}
        <a href="#" class="carousel-navigation-link dropdown-item {{#menuclasses}} {{.}} {{/menuclasses}}" role="menuitem" tabindex="-1" data-carousel-target-id="carousel-item-{{submenuid}}" {{#tooltip}}title="{{.}}" data-bs-toggle="tooltip"{{/tooltip}}
        {{#attributes}}{{#name}}{{name}}="{{value}}"{{/name}}{{/attributes}}>
            {{#pixicon}}
                {{#pix}}{{pixicon}}{{/pix}}
            {{/pixicon}}
            {{^pixicon}}
                {{#imgsrc}}<img aria-hidden="true" src="{{imgsrc}}" alt="{{title}}"/>{{/imgsrc}}
            {{/pixicon}}
            {{#text}}{{{text}}}{{/text}}{{^text}}{{title}}{{/text}}
        </a>
    {{/submenulink}}
    {{#divider}}<div class="dropdown-divider"></div>{{/divider}}
{{/items}}
{{/everontiles}}
